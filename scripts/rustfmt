#!/usr/bin/env bash
# rustfmt from the pinned nightly, for the unstable options in rustfmt.toml. Selected via RUSTFMT in mise.toml.
# Outside mise (an editor launched from the desktop), read the pinned nightly from mise.toml.
nightly=${BRUSHCRAFT_NIGHTLY:-$(sed -n 's/^BRUSHCRAFT_NIGHTLY = "\(.*\)"$/\1/p' "$(dirname "$0")/../mise.toml")}
exec rustup run "${nightly:?BRUSHCRAFT_NIGHTLY not found in mise.toml}" rustfmt "$@"
